{
  "name": "chess.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser chess training with Stockfish, 3 million puzzles, opening study, classic games, and manual WebRTC LAN play.",
  "scripts": {
    "start": "node server.js",
    "lan": "node server.js --lan",
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "stockfish": "19.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
